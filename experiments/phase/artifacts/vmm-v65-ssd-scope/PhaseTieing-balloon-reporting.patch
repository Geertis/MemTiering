+	struct virtqueue *vq = vb->vqs[Q_REPORTING];
+	struct scatterlist *entry;
+	unsigned int unused, i;
+	int err;
+
+	/* The reporting core isolates these free pages until the host ACK.
+	 * Returning early would expose pages still being discarded by the host.
+	 * This queue has one producer: the serialized reporting core worker.
