+	err = virtqueue_add_inbuf(vq, sg, nents, vb, GFP_NOWAIT | __GFP_NOWARN);
+	if (err) {
+		reporting_failures++;
+		return err;
+	}
+	virtqueue_kick(vq);
+	wait_event(vb->ack, virtqueue_get_buf(vq, &unused));
+	for_each_sg(sg, entry, nents, i) {
+		unsigned long pages = entry->length >> PAGE_SHIFT;
+		int nid = page_to_nid(sg_page(entry));
+		reporting_pages += pages;
+		if (nid == first_node(node_states[N_MEMORY]))
+			reporting_fast_pages += pages;
+		else if (nid == last_node(node_states[N_MEMORY]))
+			reporting_slow_pages += pages;
+	}
+	reporting_batches++;
+	return 0;
 }
 
