+int demeter_migrate_folio_to_node(struct folio *folio, int node)
+{
+	LIST_HEAD(pagelist);
+	struct migration_target_control mtc = {
+		.nid = node,
+		.gfp_mask = GFP_NOWAIT | __GFP_HIGHMEM | __GFP_MOVABLE |
+			    __GFP_THISNODE | __GFP_NOWARN,
+	};
