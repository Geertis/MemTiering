diff --git a/mm/PhaseTieing/mpsc.h b/mm/PhaseTieing/mpsc.h
--- a/mm/PhaseTieing/mpsc.h
+++ b/mm/PhaseTieing/mpsc.h
@@ -3,8 +3,15 @@
 
 typedef struct trace_buffer *mpsc_t;
-noinline static inline mpsc_t mpsc_new(size_t bytes_per_cpu)
+noinline static inline mpsc_t mpsc_new(size_t total_bytes)
 {
+	/* ring_buffer_alloc() takes a per-CPU size.  Demeter's limit is a
+	 * per-channel budget; passing it through directly multiplies every
+	 * target by nr_cpu_ids and makes multi-sandbox guests run out of memory.
+	 */
+	size_t bytes_per_cpu = max_t(size_t, PAGE_SIZE,
+				       DIV_ROUND_UP(total_bytes,
+						    num_online_cpus()));
	return ring_buffer_alloc(bytes_per_cpu, RB_FL_OVERWRITE);
 }
